<!doctype html><html lang="zh-CN"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>你的小黎已上线</title><style>*{box-sizing:border-box}body{margin:0;background:#eef6fb;color:#31465c;font:16px system-ui,sans-serif;text-align:center}main{max-width:640px;margin:5vh auto;background:white;border-radius:22px;padding:24px}svg{width:min(410px,80vw);display:block;margin:auto}button{background:#e6f1f9;border:0;border-radius:8px;padding:9px 14px;color:inherit;cursor:pointer;margin:3px}p{line-height:1.75}</style><main><h1>你的小黎已上线</h1><p>按 Q、P、Z 对比手的位置，再把鼠标从远处移到小黎头上。</p><svg id="pet" viewBox="0 0 320 320"></svg><button id="glasses">推推眼镜</button><button id="speed">慢放 ×0.25</button><button id="pause">暂停</button><p id="status"></p></main><script>
(async()=>{let api;const wasi={fd_close:()=>8,fd_seek:()=>8,fd_write:()=>8,environ_get:()=>0,environ_sizes_get:(a,b)=>{const v=new DataView(api.memory.buffer);v.setUint32(a,0,true);v.setUint32(b,0,true);return 0;},proc_exit:()=>{throw Error('预览已结束')}};const bytes=Uint8Array.from(atob('WASM_BYTES'),c=>c.charCodeAt(0));api=(await WebAssembly.instantiate(bytes,{wasi_snapshot_preview1:wasi})).instance.exports;api._initialize();const pet=document.querySelector('svg'),text=new TextDecoder();let x=1,y=0,hover=false,paused=false,rate=1,last=0;
onpointermove=e=>{const r=pet.getBoundingClientRect(),px=(e.clientX-r.left)/r.width*320,py=(e.clientY-r.top)/r.height*320;x=(px-160)/220;y=(py-132)/200;hover=((px-160)/91)**2+((py-106)/83)**2<1||(px>105&&px<210&&py>176&&py<245);};
document.documentElement.onpointerleave=()=>{hover=false;x=2;y=0;};
onkeydown=e=>{if(!e.ctrlKey&&!e.metaKey&&!e.altKey&&/^Key[A-Z]$/.test(e.code))api.letter(e.code.charCodeAt(3));};
document.querySelector('#glasses').onclick=()=>api.glasses();
document.querySelector('#speed').onclick=e=>{rate=rate===1?.25:1;e.target.textContent=rate===1?'慢放 ×0.25':'恢复常速';};
document.querySelector('#pause').onclick=e=>{paused=!paused;e.target.textContent=paused?'继续':'暂停';};
function frame(t){if(!paused&&t-last>=30){const ptr=api.render(Math.min(.1,(t-last)/1000)*rate,x,y,+hover);pet.innerHTML=text.decode(new Uint8Array(api.memory.buffer,ptr,api.length()));last=t;}if(paused)last=t;requestAnimationFrame(frame);}requestAnimationFrame(frame);})().catch(e=>document.querySelector('#status').textContent='预览加载失败：'+e.message);
</script></html>
